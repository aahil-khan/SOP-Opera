# Backend
DATABASE_URL=postgresql+asyncpg://sop:sop@localhost:5433/sop_opera
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: regex for local dev when Next.js picks another port (empty to disable)
# CORS_LOCALHOST_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# AI providers: mock | openai_compatible | ollama
#
# Default is `mock` so a fresh clone works with nothing else installed: no API key,
# no model server, no network. Narration is a deterministic template and the UI says
# so ("deterministic narration · no LLM configured") rather than implying reasoning.
# Do not default this to a provider that needs credentials — scripts/run-*.sh copies
# this file to .env verbatim, and an AI_PROVIDER set here is treated as an explicit
# choice, which suppresses the automatic fallback to mock. A clone without the
# matching key or model server would then fail every assessment after
# ASSESSMENT_MAX_RETRIES with no way back short of editing .env.
#
# DEMO (real AI): flip AI_PROVIDER=openai_compatible + set OPENAI_API_KEY to make the
# agent narration genuine, streamed LLM prose (not templates). The safety verdict stays
# deterministic in app/risk/policy.py regardless — the LLM only writes summary/observation
# text, never risk_level. Pair with EMBEDDING_PROVIDER below for real semantic retrieval.
# `ollama` is the offline equivalent: set OLLAMA_MODEL to a model you have pulled.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Assessment
ASSESSMENT_MAX_RETRIES=1

# Sensor & rule thresholds (backend source of truth — UI reads GET /api/config/thresholds)
# Elevated = compound-engine early warning; critical = single-sensor incident line.
# Critical must stay above elevated for gas/temp.
GAS_ELEVATED_THRESHOLD=20.0
GAS_CRITICAL_THRESHOLD=50.0
TEMP_ELEVATED_THRESHOLD=80.0
TEMP_CRITICAL_THRESHOLD=120.0
VIBRATION_ANOMALY_THRESHOLD=7.1
EFFLUENT_PH_MIN=6.0
EFFLUENT_PH_MAX=9.0
TANK_LEVEL_HIGH_PCT=95.0
TANK_LEVEL_LOW_PCT=5.0
WEATHER_WIND_HOLD_MS=15.0
CERT_EXPIRY_WARNING_DAYS=14

# Simulator
SIMULATOR_DEFAULT_STEP_DELAY_SECONDS=5
BLOCKED_INACTIVE_MIN_SECONDS=15
BLOCKED_INACTIVE_MAX_SECONDS=60

# RAG / embeddings
#
# EMBEDDING_PROVIDER decides whether vectors mean anything:
#   mock | local          SHA-256 hash expansion. Stable and dependency-free, but
#                         similarity is noise — the quality gate can never pass,
#                         so retrieval always falls through to deterministic SQL.
#                         This is the default and it is an honest one; just don't
#                         call the regulatory path RAG while it is on.
#   ollama                REAL semantic vectors, local, no API key. Needs a local
#                         Ollama + `ollama pull nomic-embed-text`. 768-dim, zero-
#                         padded to EMBEDDING_DIM, which leaves cosine unchanged.
#   openai_compatible     Hosted. Needs OPENAI_API_KEY. Uses EMBEDDING_MODEL.
#
# knowledge_chunks re-embed on every boot via the configured provider
# (seed_embeddings DELETEs+reinserts), so switching provider needs no manual re-seed.
#
# THEN TUNE RAG_SCORE_THRESHOLD — it is per embedding model, and 0.72 is the mock-era
# number. Measure, don't guess:  python -m app.eval.rag_calibration
#   nomic-embed-text (re-measured 19 Aug 2026 over historical_incidents, the only
#     population the gate sees): relevant 0.774, best distractor 0.586 → use 0.68.
#     The 0.62 previously documented here came from an unrestricted run and is
#     workable but thin — it clears the distractor by only 0.034 against 0.094.
#   text-embedding-3-small (measured 19 Aug 2026): MEASURE WITH --source SET TO YOUR
#     RAG_VECTOR_SOURCE_TYPES. Over historical_incidents (the default, and the only
#     population the gate sees): relevant 0.604, best distractor 0.435 → use 0.52.
#     The unrestricted run suggests 0.59, but its top rows are SOPs that are never
#     vector-searched, and 0.59 rejects every incident — the live pipeline then
#     reports retrieval_mode=deterministic. Thresholds transfer between neither
#     embedding models nor source-type sets.
# Too high → everything falls back to deterministic SQL and the echo score stays null.
RAG_ENABLED=true
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=1536
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.52
RAG_TIMEOUT_MS=3000
# Source types eligible for vector search (JSON list). Default is incidents-only.
# With a semantic provider, regulations and SOPs are searchable too — the
# deterministic path still runs underneath, so citation coverage cannot regress:
# RAG_VECTOR_SOURCE_TYPES=["historical_incidents","regulations","sops"]
#
# Fully-offline real-RAG profile (no key, no egress):
#   AI_PROVIDER=ollama
#   EMBEDDING_PROVIDER=ollama
#   RAG_SCORE_THRESHOLD=0.68
#   AGENT_TIMEOUT_SECONDS=240
#   AGENT_LLM_TIMEOUT_SECONDS=90
# Needs both models present: `ollama pull nomic-embed-text` (embeddings) and
# `ollama pull llama3.2` (narration). Switching EMBEDDING_PROVIDER re-embeds the
# whole corpus on next boot, so the two profiles cannot be mixed — a corpus
# embedded by one provider scores as noise against the other.
#
# THE RAISED TIMEOUTS ARE NOT OPTIONAL. The 45s AGENT_TIMEOUT_SECONDS default is
# sized for a hosted model. Measured 19 Aug 2026 on the hero compound_risk
# scenario with llama3.2: agent latency 51,312ms — over the default, so both
# attempts (assessment_max_retries=1) time out and the review sits in
# `assessing` with nothing to show. With the values above the same run completes
# in 65s wall-clock: retrieval_mode=rag, retrieval_quality=good,
# retrieval_score=0.774, embedding_model=nomic-embed-text, 11 references.
# The local model is a genuine fallback, not a demo path — budget for it.
#
# Hosted real-RAG profile (validated end to end 19 Aug 2026 — retrieval_mode=rag,
# retrieval_quality=good on the hero compound_risk run):
#   AI_PROVIDER=openai_compatible
#   EMBEDDING_PROVIDER=openai_compatible
#   RAG_SCORE_THRESHOLD=0.52
# A threshold below the distractor score is as wrong as one above the relevant
# score: too low admits off-topic chunks as evidence, too high falls back to
# deterministic SQL. Measure, then set.

# LangGraph multi-agent + LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sop-opera
# Optional override for the Open LangSmith button (defaults to https://smith.langchain.com)
LANGSMITH_PROJECT_URL=
AGENT_SPATIAL_RADIUS_M=15.0
AGENT_SCALE_M_PER_PX=0.04
AGENT_TIMEOUT_SECONDS=45
AGENT_LLM_TIMEOUT_SECONDS=20
PREDICTIVE_TREND_HORIZON_MINUTES=15.0
PREDICTIVE_TREND_MIN_R2=0.55
PREDICTIVE_TREND_MIN_SAMPLES=2

# Live feed (ambient plant telemetry) — on/off by default at API boot.
# Toggle at runtime from Demo controls; this only sets the startup default.
# true = start with Live feed on; false = start with Live feed off.
AMBIENT_ENABLED=true
AMBIENT_TICK_SECONDS=3.0
AMBIENT_COINCIDENCE_PROBABILITY=0.01
AMBIENT_HEARTBEAT_SECONDS=120
AMBIENT_BATCH_SIZE=2
AMBIENT_STATUS_EVERY_N_TICKS=4

# Frontend (Next.js) — copy relevant into frontend/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
